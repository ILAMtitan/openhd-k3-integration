# OpenHD application policy. Hardware discovery, DCC, media-node identity,
# TIOVX pool defaults, and remoteproc lifecycle come from ti-k3-accelerators.
OPENHD_CAMERA_PROFILE=imx219-ti-isp-720p30
OPENHD_CAMERA_MODE=imx219-ti-isp
OPENHD_CAMERA_FAILURE_POLICY=fail

OPENHD_CAMERA_CODEC=h264
OPENHD_CAMERA_RTP_HOST=127.0.0.1
OPENHD_CAMERA_RTP_PORT=5500
OPENHD_CAMERA_RTP_MTU=1024
OPENHD_CAMERA_BITRATE=3000000
OPENHD_CAMERA_GOP=15
OPENHD_CAMERA_WIDTH=1280
OPENHD_CAMERA_HEIGHT=720
OPENHD_CAMERA_FPS=30

# DCC-qualified IMX219 capture mode used by the application profile.
OPENHD_CAMERA_SENSOR_WIDTH=1920
OPENHD_CAMERA_SENSOR_HEIGHT=1080
OPENHD_CAMERA_SENSOR_FPS=30

# Keep CSI DMA-BUF import on the capture side, but do not request the Wave5
# encoder output-io-mode=dmabuf-import path used by earlier experiments.
OPENHD_CAMERA_USE_DMABUF_IMPORT=no
OPENHD_CAMERA_ALLOW_SW_FALLBACK=no
OPENHD_CAMERA_H264_LEVEL=auto
OPENHD_CAMERA_H264_PROFILE=0
OPENHD_CAMERA_PREPEND_SPS_PPS=yes
OPENHD_CAMERA_WAVE5_EXTRA_CONTROLS=frame_level_rate_control_enable=1
