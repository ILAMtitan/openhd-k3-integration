Subject: [PATCH 10/10] video: prepare native TI J722S IMX415 pipeline

Add a pre-hardware Arducam B0569 / Sony IMX415 path alongside the qualified
IMX219 and IMX708 camera types. Capture the full 3864x2192 GBRG10 sensor frame
at nominal 30 fps, process it through VPAC/VISS, scale to 1280x720 with the TI
multiscaler, and encode H.264 with Wave5.

R0 keeps AE/AWB disabled and uses DCC slot 219 only as a registry compatibility
mechanism. The 6 Mbit/s bitrate retains the physically clean RF baseline from
the IMX708 qualification until dynamic Wave5 bitrate control is implemented.
---
 OpenHD/ohd_video/inc/camera_holder.h       |  6 +++
 OpenHD/ohd_video/inc/gst_helper.hpp        | 70 ++++++++++++++++++++++++++++++
 OpenHD/ohd_video/misc/camera_registry.json | 12 +++++-
 OpenHD/ohd_video/src/gstreamerstream.cpp   |  4 ++
 4 files changed, 91 insertions(+), 1 deletion(-)

diff --git a/OpenHD/ohd_video/inc/camera_holder.h b/OpenHD/ohd_video/inc/camera_holder.h
--- a/OpenHD/ohd_video/inc/camera_holder.h
+++ b/OpenHD/ohd_video/inc/camera_holder.h
@@ -261,6 +261,12 @@ class CameraHolder :
       ret.h26x_bitrate_kbits = 6000;
       ret.h26x_keyframe_interval = 28;
     }
+    if (m_camera.camera_type == X_CAM_TYPE_TI_J722S_IMX415) {
+      // R0 starts at the physically clean TI RF baseline. IMX415 itself is
+      // not hardware-qualified yet.
+      ret.h26x_bitrate_kbits = 6000;
+      ret.h26x_keyframe_interval = 15;
+    }
     return ret;
   }
 };
diff --git a/OpenHD/ohd_video/inc/gst_helper.hpp b/OpenHD/ohd_video/inc/gst_helper.hpp
--- a/OpenHD/ohd_video/inc/gst_helper.hpp
+++ b/OpenHD/ohd_video/inc/gst_helper.hpp
@@ -1051,6 +1051,76 @@ static std::string create_ti_j722s_imx708_stream(
   return ss.str();
 }
 
+static std::string create_ti_j722s_imx415_stream(
+    const CameraSettings& settings) {
+  const int bitrate_bps =
+      openhd::kbits_to_bits_per_second(settings.h26x_bitrate_kbits);
+  const int gop =
+      settings.h26x_keyframe_interval > 0 ? settings.h26x_keyframe_interval : 15;
+
+  std::stringstream ss;
+
+  ss << "v4l2src device=/run/ti-k3/camera-video "
+        "io-mode=dmabuf-import do-timestamp=true ! ";
+
+  // The Beagle 6.12.49 IMX415 driver exposes full-array GBRG RAW10 only.
+  ss << "video/x-bayer,format=gbrg10le,width=3864,height=2192,"
+        "framerate=30/1 ! ";
+
+  // The qualified TI compatibility core maps gbrg10le to the same 16-bit raw
+  // container as the legacy gbrg10 spelling; capssetter changes metadata only.
+  ss << "capssetter caps=\"video/x-bayer,format=gbrg10\" "
+        "join=true replace=false ! ";
+
+  // R0 uses registry/DCC slot 219 only for compatibility. Do not enable TI
+  // AE/AWB until native IMX415 exposure/gain mapping exists.
+  ss << "tiovxisp "
+        "sensor-name=SENSOR_SONY_IMX219_RPI "
+        "dcc-isp-file=/opt/imaging/imx415/linear/"
+        "dcc_viss_3864x2192.bin "
+        "format-msb=9 "
+        "bypass-cac=true "
+        "bypass-dwb=true "
+        "sink_0::dcc-2a-file=/opt/imaging/imx415/linear/"
+        "dcc_2a_3864x2192.bin "
+        "sink_0::device=/run/ti-k3/camera-subdev "
+        "sink_0::ae-mode=AE_MODE_DISABLED "
+        "sink_0::awb-mode=AWB_MODE_DISABLED "
+        "sink_0::pool-size=4 "
+        "src::pool-size=4 ! ";
+
+  ss << "video/x-raw,format=NV12,width=3864,height=2192,"
+        "framerate=30/1 ! ";
+
+  // Initial FPV output is 720p30. R1 can qualify a centered 3840x2160 ROI
+  // before scaling if needed to avoid the tiny full-array aspect adjustment.
+  ss << "tiovxmultiscaler target=0 ! ";
+  ss << "video/x-raw,format=NV12,width=1280,height=720,framerate=30/1 ! ";
+
+  ss << "queue max-size-buffers=1 max-size-bytes=0 "
+        "max-size-time=0 leaky=downstream ! ";
+
+  ss << fmt::format(
+      "v4l2h264enc name=ti_wave5_encoder "
+      "extra-controls=\"controls,"
+      "frame_level_rate_control_enable=1,"
+      "video_bitrate={},"
+      "video_gop_size={},"
+      "h264_level=9,"
+      "h264_profile=0,"
+      "prepend_sps_and_pps_to_idr=1\" ! ",
+      bitrate_bps, gop);
+
+  ss << "video/x-h264,stream-format=byte-stream,alignment=au ! ";
+
+  return ss.str();
+}
