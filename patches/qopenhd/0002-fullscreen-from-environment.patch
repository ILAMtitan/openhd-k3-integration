From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenHD BeagleY-AI Ground Port <porting@example.invalid>
Date: Wed, 5 Aug 2026 12:30:00 -0500
Subject: [PATCH] ui: support manual-launch fullscreen environment
---
 app/main.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/app/main.cpp b/app/main.cpp
--- a/app/main.cpp
+++ b/app/main.cpp
@@ -2,3 +2,4 @@
 #include "qscreen.h"
 #include <QApplication>
+#include <QWindow>
 #include <QQmlApplicationEngine>
@@ -499,3 +500,12 @@ int main(int argc, char *argv[]) {
     const QUrl url(QStringLiteral("qrc:/main.qml"));
     engine.load(url);
+    const QByteArray start_fullscreen=qgetenv("QOPENHD_START_FULLSCREEN");
+    if(!start_fullscreen.isEmpty() && start_fullscreen!="0" &&
+       !engine.rootObjects().isEmpty()){
+        auto* root_window=qobject_cast<QWindow*>(engine.rootObjects().constFirst());
+        if(root_window!=nullptr){
+            qDebug()<<"Starting QOpenHD fullscreen by environment request";
+            root_window->showFullScreen();
+        }
+    }
     //engine.loadFromModule("QOpenHD", "qrc:/main.qml");
