#!/usr/bin/env bash
set -Eeuo pipefail

MODE=${OPENHD_IMX708_MODE:-864p60}
EXPOSURE=${OPENHD_IMX708_EXPOSURE:-1280}
ANALOGUE_GAIN=${OPENHD_IMX708_ANALOGUE_GAIN:-512}
DIGITAL_GAIN=${OPENHD_IMX708_DIGITAL_GAIN:-256}

for cmd in ti-k3-rpmsg-ready ti-k3-configure-imx708-graph v4l2-ctl; do
  command -v "$cmd" >/dev/null || {
    echo "Missing required IMX708 dependency: $cmd" >&2
    exit 1
  }
done

for f in \
  /opt/imaging/imx708/linear/dcc_viss_1536x864.bin \
  /opt/imaging/imx708/linear/dcc_2a_1536x864.bin; do
  [[ -s "$f" ]] || {
    echo "Missing IMX708 1536x864 DCC file: $f" >&2
    exit 1
  }
done

ti-k3-rpmsg-ready

ti-k3-configure-imx708-graph --mode "$MODE"

[[ -e /run/ti-k3/camera-video ]] || {
  echo "IMX708 camera-video contract missing" >&2
  exit 1
}
[[ -e /run/ti-k3/camera-subdev ]] || {
  echo "IMX708 camera-subdev contract missing" >&2
  exit 1
}
[[ -r /run/ti-k3/camera.env ]] || {
  echo "IMX708 camera.env contract missing" >&2
  exit 1
}
grep -Fq 'TI_K3_CAMERA_MODE=864p60' /run/ti-k3/camera.env || {
  echo "IMX708 camera graph is not in the required 864p60 mode" >&2
  exit 1
}

# TI AE/AWB remain disabled because the deployed TI sensor registry still uses
# the IMX219 compatibility slot. These manual values remain environment-
# overridable; 1280 lines is valid with the 864p60 frame length (1810 lines).
v4l2-ctl -d /run/ti-k3/camera-subdev \
  --set-ctrl="exposure=${EXPOSURE},analogue_gain=${ANALOGUE_GAIN},digital_gain=${DIGITAL_GAIN}" \
  >/dev/null

echo "OpenHD IMX708 720p60 camera graph ready: mode=$MODE exposure=$EXPOSURE analogue_gain=$ANALOGUE_GAIN digital_gain=$DIGITAL_GAIN"
