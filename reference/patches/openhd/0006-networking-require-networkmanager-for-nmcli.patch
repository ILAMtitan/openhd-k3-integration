From 61a03c12c4e08f2df142f32db561adb591dd9801 Mon Sep 17 00:00:00 2001
From: OpenHD BeagleY-AI Port <porting@example.invalid>
Date: Mon, 3 Aug 2026 18:00:00 +0000
Subject: [PATCH 6/6] networking: require NetworkManager before using nmcli

BeagleY-AI uses systemd-networkd and intentionally does not install nmcli.
Avoid command-not-found warnings for monitor radios, skip hotspot creation when
NetworkManager is unavailable, and never report a hotspot as started after a
failed nmcli command.
---
 OpenHD/ohd_interface/inc/wifi_hotspot.h        |  1 +
 OpenHD/ohd_interface/src/wifi_command_helper.cpp |  8 ++++++++
 OpenHD/ohd_interface/src/wifi_hotspot.cpp      | 64 ++++++++++++++++++------
 3 files changed, 57 insertions(+), 16 deletions(-)

diff --git a/OpenHD/ohd_interface/inc/wifi_hotspot.h b/OpenHD/ohd_interface/inc/wifi_hotspot.h
--- a/OpenHD/ohd_interface/inc/wifi_hotspot.h
+++ b/OpenHD/ohd_interface/inc/wifi_hotspot.h
@@ -78,6 +78,7 @@ class WifiHotspot {
   const OHDProfile m_profile;
   const WiFiCard m_wifi_card;
   bool started = false;
+  bool m_connection_ready = false;
   std::shared_ptr<spdlog::logger> m_console;
   bool m_use_5G_channel;
   bool m_is_enabled = false;
diff --git a/OpenHD/ohd_interface/src/wifi_command_helper.cpp b/OpenHD/ohd_interface/src/wifi_command_helper.cpp
--- a/OpenHD/ohd_interface/src/wifi_command_helper.cpp
+++ b/OpenHD/ohd_interface/src/wifi_command_helper.cpp
@@ -211,6 +211,14 @@ bool wifi::commandhelper::nmcli_set_device_managed_status(
     const std::string &device, bool managed) {
   get_logger()->info("nmcli_set_device_managed_status {} managed:{}", device,
                      managed);
+  if (!OHDFilesystemUtil::exists("/usr/bin/nmcli") &&
+      !OHDFilesystemUtil::exists("/bin/nmcli")) {
+    get_logger()->debug(
+        "nmcli is unavailable; management state for {} is handled by the "
+        "system network configuration",
+        device);
+    return true;
+  }
   std::vector<std::string> arguments{"device", "set", device, "managed"};
   if (managed) {
     arguments.emplace_back("yes");
diff --git a/OpenHD/ohd_interface/src/wifi_hotspot.cpp b/OpenHD/ohd_interface/src/wifi_hotspot.cpp
--- a/OpenHD/ohd_interface/src/wifi_hotspot.cpp
+++ b/OpenHD/ohd_interface/src/wifi_hotspot.cpp
@@ -29,6 +29,7 @@
 #include "openhd_naming.h"
 #include "openhd_spdlog.h"
 #include "openhd_util_async.h"
+#include "openhd_util_filesystem.h"
 
 static constexpr auto OHD_WIFI_HOTSPOT_CONNECTION_NAME = "ohd_wifi_hotspot";
 const std::string blue = "\033[34m";
@@ -40,6 +41,14 @@ static std::string get_ohd_wifi_hotspot_connection_nm_filename() {
                      OHD_WIFI_HOTSPOT_CONNECTION_NAME);
 }
 
+static bool network_manager_available() {
+  if (!OHDFilesystemUtil::exists("/usr/bin/nmcli") &&
+      !OHDFilesystemUtil::exists("/bin/nmcli")) {
+    return false;
+  }
+  return OHDUtil::run_command("nmcli", {"general", "status"}, false) == 0;
+}
+
 static std::string resolve_hotspot_ssid(bool is_air,
                                         const std::string& override_ssid) {
   if (override_ssid.empty()) {
@@ -66,6 +75,11 @@ static bool create_hotspot_connection_file(
 static bool create_hotspot_connection_file(
     const WiFiCard& card, const bool is_air, const bool use_5g_channel,
     const std::string& ssid_override, const std::string& password_override) {
+  if (!network_manager_available()) {
+    openhd::log::get_default()->info(
+        "WiFi hotspot disabled: NetworkManager/nmcli is unavailable");
+    return false;
+  }
   // delete any previous connection that might exist. This might fail if no
   // connection of that name exists - aka an error here can be ignored. We
   // re-create it just to be sure, since for example, the wifi card might have
@@ -84,25 +98,31 @@ static bool create_hotspot_connection_file(
   // and create the hotspot one
   const auto ssid = resolve_hotspot_ssid(is_air, ssid_override);
   const auto password = resolve_hotspot_password(password_override);
-  OHDUtil::run_command(
+  bool success = OHDUtil::run_command(
       "nmcli", {"con add type wifi ifname", card.device_name, "con-name",
                 OHD_WIFI_HOTSPOT_CONNECTION_NAME, "autoconnect no",
-                fmt::format("ssid {}", ssid)});
-  OHDUtil::run_command("nmcli",
+                fmt::format("ssid {}", ssid)}) == 0;
+  success =
+      (OHDUtil::run_command("nmcli",
                        {"con modify ", OHD_WIFI_HOTSPOT_CONNECTION_NAME,
                         " 802-11-wireless.mode ap", "802-11-wireless.band",
-                        use_5g_channel ? "a" : "bg", "ipv4.method shared"});
-  OHDUtil::run_command("nmcli",
+                        use_5g_channel ? "a" : "bg", "ipv4.method shared"}) ==
+       0) && success;
+  success = (OHDUtil::run_command("nmcli",
                        {"con modify ", OHD_WIFI_HOTSPOT_CONNECTION_NAME,
-                        " wifi-sec.key-mgmt wpa-psk"});
-  OHDUtil::run_command("nmcli",
+                        " wifi-sec.key-mgmt wpa-psk"}) == 0) && success;
+  success = (OHDUtil::run_command("nmcli",
                        {"con modify ", OHD_WIFI_HOTSPOT_CONNECTION_NAME,
-                        fmt::format(" wifi-sec.psk \"{}\"", password)});
-  OHDUtil::run_command("nmcli", {"con modify", OHD_WIFI_HOTSPOT_CONNECTION_NAME,
-                                 "ipv4.addresses 192.168.3.1/24"});
-  return true;
+                        fmt::format(" wifi-sec.psk \"{}\"", password)}) == 0) &&
+            success;
+  success = (OHDUtil::run_command(
+                 "nmcli", {"con modify", OHD_WIFI_HOTSPOT_CONNECTION_NAME,
+                            "ipv4.addresses 192.168.3.1/24"}) == 0) &&
+            success;
+  return success;
 }
 
 bool WifiHotspot::util_delete_nm_file() {
+  if (!network_manager_available()) return false;
   // cleanup - proper stop of openhd, do not leave any traces behind.
   if (OHDFilesystemUtil::exists(
@@ -128,7 +149,7 @@ WifiHotspot::WifiHotspot(OHDProfile profile, WiFiCard wifiCard,
   // just enable / disable it by running connection up / down.
   m_console->debug("begin create hotspot connection");
-  create_hotspot_connection_file(m_wifi_card, m_profile.is_air,
-                                 m_use_5G_channel, m_hotspot_ssid_override,
-                                 m_hotspot_password_override);
+  m_connection_ready = create_hotspot_connection_file(
+      m_wifi_card, m_profile.is_air, m_use_5G_channel,
+      m_hotspot_ssid_override, m_hotspot_password_override);
   m_console->debug("end create hotspot connection");
 }
@@ -140,9 +162,18 @@ WifiHotspot::~WifiHotspot() { util_delete_nm_file(); }
 
 void WifiHotspot::start() {
   m_console->debug("Starting WIFI hotspot on card {}", m_wifi_card.device_name);
+  if (!m_connection_ready) {
+    m_console->info(
+        "WiFi hotspot remains disabled because NetworkManager setup was not "
+        "available");
+    return;
+  }
   const auto args =
       std::vector<std::string>{"con", "up", OHD_WIFI_HOTSPOT_CONNECTION_NAME};
-  OHDUtil::run_command("nmcli", args);
+  if (OHDUtil::run_command("nmcli", args) != 0) {
+    m_console->error("Failed to start WiFi hotspot");
+    return;
+  }
   started = true;
   m_console->info("Wifi hotspot started");
   std::cout << blue << "Started WIFI hotspot on card "
@@ -155,6 +185,9 @@ void WifiHotspot::stop() {
   if (!started) return;
   const auto args =
       std::vector<std::string>{"con", "down", OHD_WIFI_HOTSPOT_CONNECTION_NAME};
-  OHDUtil::run_command("nmcli", args);
+  if (OHDUtil::run_command("nmcli", args) != 0) {
+    m_console->warn("Failed to stop WiFi hotspot");
+  }
+  started = false;
   m_console->info("Wifi hotspot stopped");
 }
-- 
