+static std::string create_ti_j722s_imx708_stream(
+    const CameraSettings& settings) {
+  const int bitrate_bps =
+      openhd::kbits_to_bits_per_second(settings.h26x_bitrate_kbits);
+  const int gop =
+      settings.h26x_keyframe_interval > 0
+          ? settings.h26x_keyframe_interval
+          : 30;
+
+  std::stringstream ss;
+
+  ss << "v4l2src device=/run/ti-k3/camera-video "
+        "io-mode=dmabuf-import do-timestamp=true ! ";
+
+  ss << "video/x-bayer,format=rggb10le,width=1536,height=864,"
+        "framerate=60/1 ! ";
+
+  ss << "capssetter caps=\"video/x-bayer,format=rggb10\" "
+        "join=true replace=false ! ";
+
+  ss << "tiovxisp "
+        "sensor-name=SENSOR_SONY_IMX219_RPI "
+        "dcc-isp-file=/opt/imaging/imx708/linear/"
+        "dcc_viss_1536x864.bin "
+        "format-msb=9 "
+        "bypass-cac=true "
+        "bypass-dwb=true "
+        "sink_0::dcc-2a-file=/opt/imaging/imx708/linear/"
+        "dcc_2a_1536x864.bin "
+        "sink_0::device=/run/ti-k3/camera-subdev "
+        "sink_0::ae-mode=AE_MODE_DISABLED "
+        "sink_0::awb-mode=AWB_MODE_DISABLED "
+        "sink_0::pool-size=2 "
+        "src::pool-size=2 ! ";
+
+  ss << "video/x-raw,format=NV12,width=1536,height=864,"
+        "framerate=60/1 ! ";
+
+  ss << "tiovxmultiscaler target=0 ! ";
+
+  ss << "video/x-raw,format=NV12,width=1280,height=720,"
+        "framerate=60/1 ! ";
+
+  ss << "queue max-size-buffers=1 max-size-bytes=0 "
+        "max-size-time=0 leaky=downstream ! ";
+
+  ss << fmt::format(
+      "v4l2h264enc name=ti_wave5_encoder "
+      "extra-controls=\"controls,"
+      "frame_level_rate_control_enable=1,"
+      "video_bitrate={},"
+      "video_gop_size={},"
+      "prepend_sps_and_pps_to_idr=1\" ! ",
+      bitrate_bps, gop);
+
+  ss << "video/x-h264,width=1280,height=720,framerate=60/1,"
+        "profile=(string)baseline,level=(string)3.2,"
+        "stream-format=(string)byte-stream,"
+        "alignment=(string)au ! ";
+
+  return ss.str();
+}
+
+
+static std::string create_ti_j722s_imx415_stream(
+    const CameraSettings& settings) {
+  const int bitrate_bps =
+      openhd::kbits_to_bits_per_second(settings.h26x_bitrate_kbits);
+  const int gop =
+      settings.h26x_keyframe_interval > 0
+          ? settings.h26x_keyframe_interval
+          : 15;
+
+  std::stringstream ss;
+
+  // Qualified B0569 / IMX415 full-array sensor mode.
+  ss << "v4l2src device=/run/ti-k3/camera-video "
+        "io-mode=dmabuf-import do-timestamp=true ! ";
+
+  ss << "video/x-bayer,format=gbrg10le,width=3864,height=2192,"
+        "framerate=30/1 ! ";
+
+  // TI compatibility mapper expects the legacy Bayer spelling.
+  ss << "capssetter caps=\"video/x-bayer,format=gbrg10\" "
+        "join=true replace=false ! ";
+
+  // DCC ID 219 remains compatibility-only. AE/AWB stay disabled.
+  ss << "tiovxisp "
+        "sensor-name=SENSOR_SONY_IMX219_RPI "
+        "dcc-isp-file=/opt/imaging/imx415/linear/"
+        "dcc_viss_3864x2192.bin "
+        "format-msb=9 "
+        "bypass-cac=true "
+        "bypass-dwb=true "
+        "sink_0::dcc-2a-file=/opt/imaging/imx415/linear/"
+        "dcc_2a_3864x2192.bin "
+        "sink_0::device=/run/ti-k3/camera-subdev "
+        "sink_0::ae-mode=AE_MODE_DISABLED "
+        "sink_0::awb-mode=AWB_MODE_DISABLED "
+        "sink_0::pool-size=4 "
+        "src::pool-size=4 ! ";
+
+  ss << "video/x-raw,format=NV12,width=3864,height=2192,"
+        "framerate=30/1 ! ";
+
+  // Scale the full sensor frame directly to the FPV output.
+  ss << "tiovxmultiscaler target=0 ! ";
+
+  ss << "video/x-raw,format=NV12,width=1280,height=720,"
+        "framerate=30/1 ! ";
+
+  ss << "queue max-size-buffers=1 max-size-bytes=0 "
+        "max-size-time=0 leaky=downstream ! ";
+
+  ss << fmt::format(
+      "v4l2h264enc name=ti_wave5_encoder "
+      "extra-controls=\"controls,"
+      "frame_level_rate_control_enable=1,"
+      "video_bitrate={},"
+      "video_gop_size={},"
+      "prepend_sps_and_pps_to_idr=1\" ! ",
+      bitrate_bps, gop);
+
+  ss << "video/x-h264,stream-format=byte-stream,alignment=au ! ";
+
+  return ss.str();
+}
