 #include "openhd_util_filesystem.h"
 
 static std::string GET_ERROR() { return {strerror(errno)}; }
+
+static std::optional<std::string> read_small_text_file(
+    const std::string& filename) {
+  const int fd = open(filename.c_str(), O_RDONLY | O_CLOEXEC);
+  if (fd == -1) {
+    return std::nullopt;
+  }
+  std::string result;
+  char buffer[1024];
+  while (result.size() < 16384) {
+    const auto count = read(fd, buffer, sizeof(buffer));
+    if (count == 0) {
+      break;
+    }
+    if (count < 0) {
+      close(fd);
+      return std::nullopt;
+    }
+    result.append(buffer, static_cast<std::size_t>(count));
+  }
+  close(fd);
+  return result;
+}
+
+static std::string serial_device_basename(const std::string& device) {
+  const auto slash = device.find_last_of('/');
+  return slash == std::string::npos ? device : device.substr(slash + 1);
+}
+
+static bool same_character_device(const std::string& lhs,
+                                  const std::string& rhs) {
+  struct stat lhs_stat {};
+  struct stat rhs_stat {};
+  if (stat(lhs.c_str(), &lhs_stat) != 0 || stat(rhs.c_str(), &rhs_stat) != 0) {
+    return false;
+  }
+  return S_ISCHR(lhs_stat.st_mode) && S_ISCHR(rhs_stat.st_mode) &&
+         lhs_stat.st_rdev == rhs_stat.st_rdev;
+}
+
+static bool console_name_matches_device(const std::string& device,
+                                        std::string console_name) {
+  const auto comma = console_name.find(',');
+  if (comma != std::string::npos) {
+    console_name.resize(comma);
+  }
+  if (console_name.empty()) {
+    return false;
+  }
+  if (serial_device_basename(device) == console_name) {
+    return true;
+  }
+  return same_character_device(device, "/dev/" + console_name);
+}
+
+static bool text_lists_console(const std::string& text,
+                               const std::string& device,
+                               const bool cmdline_format) {
+  std::size_t position = 0;
+  while (position < text.size()) {
+    while (position < text.size() &&
+           (text[position] == ' ' || text[position] == '\t' ||
+            text[position] == '\n' || text[position] == '\r')) {
+      ++position;
+    }
+    const auto begin = position;
+    while (position < text.size() && text[position] != ' ' &&
+           text[position] != '\t' && text[position] != '\n' &&
+           text[position] != '\r') {
+      ++position;
+    }
+    if (begin == position) {
+      continue;
+    }
+    auto token = text.substr(begin, position - begin);
+    if (cmdline_format) {
+      static constexpr auto prefix = "console=";
+      if (token.rfind(prefix, 0) != 0) {
+        continue;
+      }
+      token.erase(0, sizeof("console=") - 1);
+    }
+    if (console_name_matches_device(device, token)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static bool is_active_kernel_console(const std::string& device) {
+  if (device.empty()) {
+    return false;
+  }
+
+  // The BeagleY-AI debug header is permanently reserved for the serial console
+  // in this image profile. Compare both the configured name and device number
+  // so aliases such as /dev/serial0 cannot bypass the protection.
+  if (OHDPlatform::instance().is_beagley_ai() &&
+      (serial_device_basename(device) == "ttyS2" ||
+       same_character_device(device, "/dev/ttyS2"))) {
+    return true;
+  }
+
+  const auto active_consoles =
+      read_small_text_file("/sys/class/tty/console/active");
+  if (active_consoles.has_value() &&
+      text_lists_console(active_consoles.value(), device, false)) {
+    return true;
+  }
+
+  const auto cmdline = read_small_text_file("/proc/cmdline");
+  return cmdline.has_value() &&
+         text_lists_console(cmdline.value(), device, true);
+}
