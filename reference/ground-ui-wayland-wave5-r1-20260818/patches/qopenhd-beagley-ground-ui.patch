-    GstElement *qmlglsink = gst_bin_get_by_name(GST_BIN(m_pipeline), "qmlglsink");
+// Find qmlglsink, attach it to the Qt Quick item, then bring the sink
+// to READY before the rest of the pipeline. qmlglsink must propagate
+// Qt's GstGLDisplay before glupload/glcolorconvert create their GL context.
+static void link_gstreamer_pipe_to_qt_window(GstElement *m_pipeline,
+                                              QQuickItem *qtOutWindow){
+    GstElement *qmlglsink =
+        gst_bin_get_by_name(GST_BIN(m_pipeline), "qmlglsink");
+
     if(qmlglsink==nullptr){
-        qDebug()<<"link_gstreamer_pipe_to_qt_window: no qmlglimagesink";
+        qDebug()<<"link_gstreamer_pipe_to_qt_window: no qmlglsink";
         return;
     }
+
     link_gsteamer_to_qt_window(qmlglsink,qtOutWindow);
+
+    const GstStateChangeReturn ret =
+        gst_element_set_state(qmlglsink, GST_STATE_READY);
+
+    qDebug()<<"qmlglsink READY result:"<<ret;
+
+    if(ret == GST_STATE_CHANGE_FAILURE){
+        qWarning("qmlglsink failed to enter READY");
+    }
+
+    gst_object_unref(qmlglsink);
 }
 
 
