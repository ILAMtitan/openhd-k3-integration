# R12 camera profile. Use openhd-camera-profile to select a named profile.
# Supported bridge modes: test-cpu, test-wave5, usb-h264, usb-wave5,
# imx219-ti-isp, imx708, or imx708-raw.
OPENHD_CAMERA_PROFILE=imx219-ti-isp-720p30
OPENHD_CAMERA_MODE=imx219-ti-isp
OPENHD_CAMERA_FAILURE_POLICY=fail

OPENHD_CAMERA_CODEC=h264
OPENHD_CAMERA_RTP_HOST=127.0.0.1
OPENHD_CAMERA_RTP_PORT=5500
OPENHD_CAMERA_RTP_MTU=1024
OPENHD_CAMERA_BITRATE=3000000
OPENHD_CAMERA_GOP=15
OPENHD_CAMERA_WIDTH=1280
OPENHD_CAMERA_HEIGHT=720
OPENHD_CAMERA_FPS=30

# Raw sensor capture dimensions are independent of encoded output dimensions.
# IMX219 profiles capture 1920x1080 Bayer and optionally scale to 1280x720.
OPENHD_CAMERA_SENSOR_WIDTH=1920
OPENHD_CAMERA_SENSOR_HEIGHT=1080
OPENHD_CAMERA_SENSOR_FPS=30

# USB path.
OPENHD_CAMERA_VIDEO_DEVICE=/dev/video0
OPENHD_CAMERA_RAW_FORMAT=NV12
OPENHD_CAMERA_CONVERT_TO_NV12=no
OPENHD_CAMERA_V4L2_IO_MODE=dmabuf
OPENHD_CAMERA_CSI_V4L2_IO_MODE=dmabuf-import

# CSI/TIOVX path. R12 discovery rewrites these through /run/openhd symlinks.
OPENHD_CAMERA_SUBDEV_DEVICE=/run/openhd/camera-subdev
OPENHD_CAMERA_BAYER_FORMAT=rggb
OPENHD_CAMERA_FORMAT_MSB=7
OPENHD_CAMERA_TIOVX_SINK_POOL_SIZE=8
OPENHD_CAMERA_TIOVX_SRC_POOL_SIZE=8
OPENHD_REMOTEPROC_TIMEOUT_SECONDS=120
OPENHD_REMOTEPROC_BOOTSTRAP_RETRIES=2
OPENHD_MAIN_R5_ENDPOINT_TIMEOUT_SECONDS=30
OPENHD_C7X_LOAD_DELAY_SECONDS=10
OPENHD_REMOTEPROC_SETTLE_SECONDS=2
OPENHD_RPMSG_READY_TIMEOUT_SECONDS=60
OPENHD_TI_REMOTE_LOGGER=/opt/vision_apps/vx_app_arm_remote_log.out
OPENHD_TI_HWA_TIMEOUT_SECONDS=20
OPENHD_CAMERA_SENSOR_NAME=SENSOR_SONY_IMX219_RPI
OPENHD_CAMERA_DCC_VISS=/opt/imaging/imx219/linear/dcc_viss_1920x1080.bin
OPENHD_CAMERA_DCC_2A=/opt/imaging/imx219/linear/dcc_2a_1920x1080.bin
OPENHD_CAMERA_ROTATE_180=no
OPENHD_CAMERA_SCALE_WIDTH=0
OPENHD_CAMERA_SCALE_HEIGHT=0

# Encoder behavior.
OPENHD_CAMERA_USE_DMABUF_IMPORT=no
OPENHD_CAMERA_ALLOW_SW_FALLBACK=no
OPENHD_CAMERA_H264_LEVEL=auto
OPENHD_CAMERA_H264_PROFILE=0
OPENHD_CAMERA_PREPEND_SPS_PPS=yes
OPENHD_CAMERA_WAVE5_EXTRA_CONTROLS=frame_level_rate_control_enable=1

# IMX708 remains experimental.
OPENHD_IMX708_ALLOW_UNTUNED_RAW=no
