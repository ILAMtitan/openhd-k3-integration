#!/usr/bin/env bash
set -euo pipefail
config=${OPENHD_CAMERA_CONFIG:-/etc/default/openhd-ti-camera}
finder=${OPENHD_CAMERA_FINDER:-/usr/local/sbin/openhd-find-camera-devices}
usage() { echo "Usage: $0 list | show | apply PROFILE [--no-restart]" >&2; exit 2; }
profiles=(test-wave5-720p30 test-wave5-1080p30 imx219-ti-isp-720p30 imx219-ti-isp-1080p30 usb-h264-1080p30)
[[ $# -ge 1 ]] || usage
case "$1" in
  list) printf '%s\n' "${profiles[@]}"; exit 0 ;;
  show) grep '^OPENHD_CAMERA_' "$config"; exit 0 ;;
  apply) [[ $# -ge 2 && $# -le 3 ]] || usage ;;
  *) usage ;;
esac
profile=$2
no_restart=no
[[ "${3:-}" == --no-restart ]] && no_restart=yes
case "$profile" in
  test-wave5-720p30)
    mode=test-wave5; width=1280; height=720; sensor_width=1280; sensor_height=720; bitrate=3000000 ;;
  test-wave5-1080p30)
    mode=test-wave5; width=1920; height=1080; sensor_width=1920; sensor_height=1080; bitrate=8000000 ;;
  imx219-ti-isp-720p30)
    mode=imx219-ti-isp; width=1280; height=720; sensor_width=1920; sensor_height=1080; bitrate=3000000 ;;
  imx219-ti-isp-1080p30)
    mode=imx219-ti-isp; width=1920; height=1080; sensor_width=1920; sensor_height=1080; bitrate=8000000 ;;
  usb-h264-1080p30)
    mode=usb-h264; width=1920; height=1080; sensor_width=1920; sensor_height=1080; bitrate=8000000 ;;
  *) echo "Unknown camera profile: $profile" >&2; exit 2 ;;
esac
if [[ "$mode" == imx219-ti-isp ]]; then
  "$finder" --sensor imx219 --write-env >/dev/null
fi
[[ -f "$config" ]] || { echo "Missing camera configuration: $config" >&2; exit 1; }
lock=${OPENHD_CAMERA_CONFIG_LOCK:-/run/lock/openhd-camera-config.lock}
mkdir -p "$(dirname "$lock")"
exec 9>"$lock"
flock 9
backup="${config}.last-good"
cp -a "$config" "$backup"
tmp=$(mktemp "${config}.tmp.XXXXXX")
python3 - "$config" "$tmp" "$profile" "$mode" "$width" "$height" "$sensor_width" "$sensor_height" "$bitrate" <<'PY'
from pathlib import Path
import sys
src, dst, profile, mode, width, height, sw, sh, bitrate = sys.argv[1:]
updates = {
 "OPENHD_CAMERA_PROFILE": profile,
 "OPENHD_CAMERA_MODE": mode,
 "OPENHD_CAMERA_WIDTH": width,
 "OPENHD_CAMERA_HEIGHT": height,
 "OPENHD_CAMERA_FPS": "30",
 "OPENHD_CAMERA_SENSOR_WIDTH": sw,
 "OPENHD_CAMERA_SENSOR_HEIGHT": sh,
 "OPENHD_CAMERA_SENSOR_FPS": "30",
 "OPENHD_CAMERA_BITRATE": bitrate,
 "OPENHD_CAMERA_GOP": "15" if mode == "imx219-ti-isp" else "30",
 "OPENHD_CAMERA_FAILURE_POLICY": "fail",
 "OPENHD_CAMERA_USE_DMABUF_IMPORT": "no",
}
if mode == "imx219-ti-isp":
 updates.update({
  "OPENHD_CAMERA_VIDEO_DEVICE": "/run/openhd/camera-video",
  "OPENHD_CAMERA_SUBDEV_DEVICE": "/run/openhd/camera-subdev",
  "OPENHD_CAMERA_SENSOR_NAME": "SENSOR_SONY_IMX219_RPI",
  "OPENHD_CAMERA_BAYER_FORMAT": "rggb",
  "OPENHD_CAMERA_FORMAT_MSB": "7",
  "OPENHD_CAMERA_CSI_V4L2_IO_MODE": "dmabuf-import",
  "OPENHD_CAMERA_TIOVX_SINK_POOL_SIZE": "8",
  "OPENHD_CAMERA_TIOVX_SRC_POOL_SIZE": "8",
  "OPENHD_CAMERA_DCC_VISS": "/opt/imaging/imx219/linear/dcc_viss_1920x1080.bin",
  "OPENHD_CAMERA_DCC_2A": "/opt/imaging/imx219/linear/dcc_2a_1920x1080.bin",
 })
lines = Path(src).read_text().splitlines()
seen=set(); out=[]
for line in lines:
 key=line.split("=",1)[0] if "=" in line else ""
 if key in updates:
  out.append(f"{key}={updates[key]}"); seen.add(key)
 else: out.append(line)
for key, value in updates.items():
 if key not in seen: out.append(f"{key}={value}")
Path(dst).write_text("\n".join(out)+"\n")
PY
chmod --reference="$config" "$tmp"
mv -f "$tmp" "$config"
if [[ "$no_restart" == no && -d /run/systemd/system ]]; then
  # Camera/profile changes are userspace-only. Never warm-restart remoteproc on
  # a running Vision Apps stack; a remote-core reset requires a full cold boot.
  systemctl stop openhd-ti-camera-bridge.service || true
  if ! systemctl restart openhd-imaging-prepare.service openhd-ti-camera-bridge.service; then
    cp -a "$backup" "$config"
    systemctl restart openhd-imaging-prepare.service openhd-ti-camera-bridge.service || true
    echo "Camera profile failed; restored $backup" >&2
    exit 1
  fi
fi
echo "Applied camera profile: $profile"
